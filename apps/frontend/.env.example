# Sao chép file này thành .env rồi chỉnh theo môi trường của bạn.

# true  → dùng mock trong src/mocks, Frontend chạy độc lập, không cần backend
# false → gọi backend thật qua VITE_API_BASE_URL
VITE_USE_MOCK=true

# Khi dùng mock, giá trị này chỉ là tiền tố đường dẫn.
# Khi nối backend thật, ví dụ: http://localhost:8080/api
VITE_API_BASE_URL=/api
