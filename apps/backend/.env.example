# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=en_learning
DB_USERNAME=en_learning
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------
# Khoá ký JWT (HS256). Tối thiểu 32 ký tự; thiếu hoặc quá ngắn thì app không khởi động.
# Sinh bằng: openssl rand -hex 32
JWT_SECRET=
# Khoá băm mã OTP đặt lại mật khẩu (HMAC-SHA256). Tối thiểu 32 ký tự, khác JWT_SECRET.
RESET_CODE_SECRET=
# true khi chạy sau HTTPS (production) để cookie refresh token có cờ Secure.
COOKIE_SECURE=false

# --- Gửi email (Gmail SMTP) -------------------------------------------
# Để trống thì mã đặt lại mật khẩu chỉ được ghi ra log (chỉ dùng khi phát triển).
# Gmail cần bật xác minh 2 bước rồi tạo App Password (không dùng mật khẩu đăng nhập Google).
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail luôn ghi đè người gửi bằng tài khoản đăng nhập; để trống thì dùng MAIL_USERNAME.
MAIL_FROM=

# --- AI (Luyện viết, Chat, Nói) ----------------------------------------
# Để trống thì dùng bản giả (không gọi ra ngoài). Điền key từ Google AI Studio để chấm Viết/Nói và Chat bằng Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Audio bài nghe (đợt 12) --------------------------------------------
# Để trống OPENAI_API_KEY thì "Sinh bằng AI" ra MP3 im lặng (bản giả, không gọi ra ngoài).
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Dạng cloudinary://<api_key>:<api_secret>@<cloud_name> (Cloudinary Console → Dashboard). Để trống thì lưu vào uploads/audio.
CLOUDINARY_URL=
# Đặt true để lúc khởi động sinh audio cho các bài nghe chưa có (chạy từ apps/backend; xong thì bỏ cờ).
# AUDIO_GENERATE_SEED=false

# --- Ảnh minh hoạ (đợt 13, chỉ dùng cho tools/crawler) -------------------
# Access Key của Unsplash Application (unsplash.com/oauth/applications). Để trống thì
# tools/crawler/src/generateImages.js dừng khi tới bước tìm ảnh.
UNSPLASH_ACCESS_KEY=

# --- Audio bài nghe thật (đợt 13.6, chỉ dùng cho tools/crawler) ----------
# tools/crawler/src/generateAudio.js tải audio người đọc thật (câu tiếng Anh có audio, nguồn
# Tatoeba.org, miễn phí, CC BY) rồi tải lên chính CLOUDINARY_URL ở trên (không sinh bằng OpenAI TTS
# cho seed thật nữa). Không cần thêm biến môi trường nào khác.

# --- Nạp dữ liệu thật vào DB (đợt 13.5/13i, chạy ở BE) --------------------
# Đặt true để lúc khởi động nạp resources/seed/real/*.json (20 chủ đề, 500 từ, 8 bài nghe VOA) và
# resources/seed/{reading,writing,speaking}.json (bài seed cũ đã gắn ảnh) vào DB. Idempotent nên bật
# lại vẫn an toàn, nhưng nên trả về false sau khi đã nạp xong để lần khởi động sau không quét lại.
# REAL_DATA_SEED=false
