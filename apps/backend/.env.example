# Sao chép thành .env rồi điền giá trị thật. Không commit file .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=en_learning
DB_USERNAME=en_learning
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth -------------------------------------------------------------
# Khoá ký JWT (HS256). Tối thiểu 32 ký tự; thiếu hoặc quá ngắn thì app không khởi động.
# Sinh bằng: openssl rand -hex 32
JWT_SECRET=
# Khoá băm mã OTP đặt lại mật khẩu (HMAC-SHA256). Tối thiểu 32 ký tự, khác JWT_SECRET.
RESET_CODE_SECRET=
# true khi chạy sau HTTPS (production) để cookie refresh token có cờ Secure.
COOKIE_SECURE=false

# --- Gửi email (Gmail SMTP) -------------------------------------------
# Để trống thì mã đặt lại mật khẩu chỉ được ghi ra log (chỉ dùng khi phát triển).
# Gmail cần bật xác minh 2 bước rồi tạo App Password (không dùng mật khẩu đăng nhập Google).
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail luôn ghi đè người gửi bằng tài khoản đăng nhập; để trống thì dùng MAIL_USERNAME.
MAIL_FROM=

# --- AI (Luyện viết, Chat, Nói) ----------------------------------------
# Để trống thì dùng bản giả (không gọi ra ngoài). Điền key từ Google AI Studio để chấm Viết/Nói và Chat bằng Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
